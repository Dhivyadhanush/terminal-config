{
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "disabled": true
      },
      "github": {
        "type": "local",
        "command": [
          "/bin/sh",
          "-c",
          "GITHUB_PERSONAL_ACCESS_TOKEN=\"$(/opt/homebrew/bin/gh auth token)\" exec /opt/homebrew/bin/github-mcp-server stdio"
        ]
      }
    }
  }
}
