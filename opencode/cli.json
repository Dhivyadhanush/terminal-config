{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "scope": "cwd",
    "indicators": "status"
  },
  "terminal": {
    "title": false
  },
  "diffs": {
    "view": "auto",
    "single": false
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.6
  },
  "keybinds": {
    "session.tab.select.1": "ctrl+1,<leader>1",
    "session.tab.select.2": "ctrl+2,<leader>2",
    "session.tab.select.3": "ctrl+3,<leader>3",
    "session.tab.select.4": "ctrl+4,<leader>4",
    "session.tab.select.5": "ctrl+5,<leader>5",
    "session.tab.select.6": "ctrl+6,<leader>6",
    "session.tab.select.7": "ctrl+7,<leader>7",
    "session.tab.select.8": "ctrl+8,<leader>8",
    "session.tab.select.9": "ctrl+9,<leader>9",
    "session.tab.select.10": "ctrl+0,<leader>0",
    "session.tab.next": "ctrl+tab",
    "session.tab.previous": "ctrl+shift+tab"
  }
}
