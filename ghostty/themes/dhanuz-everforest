# dhanuz-everforest
#
# Our house theme, now in Everforest: sainnhe's Everforest Dark (medium),
# colour-corrected for a dark, translucent Ghostty window.
# Base palette: Everforest (MIT, https://github.com/sainnhe/everforest).
#
# Corrections over Ghostty's built-in "Everforest Dark Med", measured against
# background #232a2e (WCAG contrast):
#
#   ANSI 9  bright red     #f85552 (4.45:1) -> #fa6b66 (5.10:1)
#   ANSI 12 bright blue    #3a94c5 (4.31:1) -> #4ba3d3 (5.19:1)
#
# Those two were the only slots under 4.5:1, so both were lifted just enough to
# clear AA on normal text while staying recognisably Everforest. Unlike the old
# Catppuccin Mocha theme there are no inverted pairs here: white < bright white
# (12.6:1 vs 14.1:1) and black stays deliberately dark because it doubles as a
# background colour.
#
# The cursor is Everforest orange #e69875 — the one warm accent in a green
# palette — so the cursor and its trail read instantly against the base.

background = #232a2e
foreground = #d3c6aa
cursor-color = #e69875
cursor-text = #232a2e
selection-background = #475258
selection-foreground = #d3c6aa

palette = 0=#7a8478
palette = 1=#e67e80
palette = 2=#a7c080
palette = 3=#dbbc7f
palette = 4=#7fbbb3
