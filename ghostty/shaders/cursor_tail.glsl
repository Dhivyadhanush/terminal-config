// Kitty-like cursor trail for Ghostty (cursor_trail 1 equivalent).
//
// Vendored from https://github.com/sahaj-b/cursor-shaders
//   file:   ghostty/cursor_tail.glsl
//   author: Sahaj Bhatt
//   license: MIT (https://github.com/sahaj-b/cursor-shaders/blob/main/LICENSE)
//
// Ghostty has no built-in cursor trail, so this shader reproduces the animated
// smear kitty draws with `cursor_trail 1`. The constants below are tuned to
// kitty's own defaults: cursor_trail_decay 0.1 0.4 and
// cursor_trail_start_threshold 2. The leading edge of the trail uses
// DECAY_FAST, the trailing edge DECAY_SLOW, and both use the same exponential
// ease-out curve as kitty's cursor_trail.c. Tune DECAY_FAST, DECAY_SLOW,
// THRESHOLD_CELLS, BLUR and TRAIL_COLOR below.

// sRGB -> Linear conversion (needed because Ghostty passes sRGB values but the shader pipeline operates in linear color space)
vec3 sRGBToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

// --- CONFIGURATION ---
vec4 TRAIL_COLOR = vec4(sRGBToLinear(iCurrentCursorColor.rgb), iCurrentCursorColor.a); // for custom color: vec4(0.2, 0.6, 1.0, 0.5); (wrap in sRGBToLinear for correct brightness)
const float DECAY_FAST = 0.10; // kitty cursor_trail_decay fastest (seconds)
const float DECAY_SLOW = 0.40; // kitty cursor_trail_decay slowest (seconds)
const float THRESHOLD_CELLS = 2.0; // kitty cursor_trail_start_threshold, per axis
const float BLUR = 2.0; // blur size in pixels (for antialiasing)

// --- CONSTANTS for easing functions ---
const float PI = 3.14159265359;
const float C1_BACK = 1.70158;
const float C2_BACK = C1_BACK * 1.525;
const float C3_BACK = C1_BACK + 1.0;
const float C4_ELASTIC = (2.0 * PI) / 3.0;
const float C5_ELASTIC = (2.0 * PI) / 4.5;
const float SPRING_STIFFNESS = 9.0;
const float SPRING_DAMPING = 0.9;

