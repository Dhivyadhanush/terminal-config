// EaseOutExpo - this is the exact exponential decay kitty's cursor trail uses
// (remaining distance = 2^(-10 * t / decay)).
float ease(float x) {
    return x == 1.0 ? 1.0 : 1.0 - pow(2.0, -10.0 * x);
}

