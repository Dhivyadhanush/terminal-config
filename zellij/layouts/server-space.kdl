// server-space — the default session (see `session_name` in config.kdl).
//
// Two tabs, nothing else: opencode first, nvim second. The tab bar and status
// bar are declared explicitly here because zellij only draws them when the
// layout includes the plugins; a bare `tab {}` list would leave you with no
// way to switch tabs.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="opencode" focus=true {
        pane command="opencode"
    }

    tab name="nvim" {
        pane command="nvim"
    }
}
